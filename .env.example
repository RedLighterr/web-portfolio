# Copy to .env. Dev (docker-compose.dev.yml) leaves the values below empty and uses its own defaults.
# Production (docker-compose.yml) requires them and the backend refuses to start with empty, repo-default
# ("portfolio", "postgres" …) or weak values (see apps/src/Security/SecretRules.cs). Enter them by hand.
POSTGRES_USER=portfolio
# At least 16 characters. Hex avoids characters ($ ; =) that break the connection string.
# Generate with: openssl rand -hex 24
# Postgres reads it only when the volume is first created — set it before the first production build.
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# Public address of the site, no trailing slash (e.g. https://example.com). Keycloak's token issuer is
# derived from it (<PUBLIC_URL>/auth/realms/portfolio). For a local production test: http://localhost:8080
PUBLIC_URL=
